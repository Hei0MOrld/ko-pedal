// ベース用のワウ(一定の速さで勝手にワウワウ動く)— 2026-09-30 試作 3 号の作り直し
// KO の要望「操作する前から絶対にエフェクトがかかってるのがわかるように」:
//  - 弾く強さではなく、一定の速さで動き続ける(弾き方で変わらない)
//  - エフェクトの音を 4 倍にして、UR12 が返す元の音に埋もれないようにする
//  - 最初からクセを強めにする
import("stdfaust.lib");

speed = hslider("[0]ワウの速さ(Hz)", 2, 0.3, 6, 0.1) : si.smoo;
q     = hslider("[1]クセの強さ", 8, 1, 12, 0.1) : si.smoo;
level = hslider("[2]音量", 1, 0, 1, 0.01) : si.smoo;

// 安全装置: どんな音が来ても ±0.5 を超えないように切る
safety = max(-0.5) : min(0.5);

// UR12 の入力1と入力2を足す
bass = +;

// 0〜1 を行き来する波で、フィルターの位置を 300〜2400Hz の間で動かす
sweep = 0.5 + 0.5 * os.osc(speed);
fc = 300 * pow(8, sweep);

process = bass : *(4) : fi.resonbp(fc, q, 1) : *(level) : safety <: _, _;
