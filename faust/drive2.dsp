// ベース用の歪み v2 — 2026-09-30
// v1 に KO が「音が安っぽい」。原因と直したところ:
//  1. 音量が大きすぎて、最後の安全装置(±0.5 で切る)で常に硬く割れていた → 出力を 0.4 以下に収める
//  2. スピーカーの箱の響きがなく、耳に痛い高音がそのまま出ていた → 急な高音カットと 400Hz の凹みで「箱」っぽく
//  3. 歪み方が上下対称で単純だった → 真空管のような非対称の歪み + 2 段で潰す
import("stdfaust.lib");

drive = hslider("[0]歪み(dB)", 30, 0, 45, 0.1) : ba.db2linear : si.smoo;
tone  = hslider("[1]明るさ(Hz)", 3500, 1000, 8000, 10) : si.smoo;
level = hslider("[2]音量", 1, 0, 1, 0.01) : si.smoo;

// 丸く潰す(±1 に収まる)
sat(x) = x / sqrt(1 + x * x);
// 真空管っぽい非対称の歪み(上と下で潰れ方が違う)
tube(x) = sat(x + 0.3) - sat(0.3);

// 安全装置: どんな音が来ても ±0.5 を超えないように切る(v2 では普段は当たらない)
safety = max(-0.5) : min(0.5);

// UR12 の入力1と入力2を足す
bass = +;

// 歪ませる前: 低音を削る(濁り防止)+ 中域(800Hz)を持ち上げて、歪みに芯を作る
pre = fi.highpass(2, 120) : fi.peak_eq(6, 800, 700);
// アンプ: 非対称に潰す → 片寄りを戻す → もう一段潰す
amp = *(drive) : tube : fi.dcblocker : *(3) : sat;
// スピーカーの箱っぽさ: 高音を急に削る + 400Hz を少し凹ませる
cab = fi.lowpass(4, tone) : fi.peak_eq(-4, 400, 300);

process = bass : pre : amp : cab : *(level * 0.4) : safety <: _, _;
