// こだま(ディレイ)— 2026-09-30 試作・強め版
// こだまの音だけを出す(元の音は UR12 が返すので、ここでは足さない)。
// KO の方針に合わせて、エフェクトの音を 3 倍・くり返し多めにして、はっきり聞こえるようにした。
import("stdfaust.lib");

time = hslider("[0]間隔(秒)", 0.4, 0.05, 1, 0.01);
fb   = hslider("[1]くり返し", 0.6, 0, 0.85, 0.01) : si.smoo;
mix  = hslider("[2]こだまの大きさ", 1, 0, 1, 0.01) : si.smoo;

d = int(time * ma.SR);

// 入力に、遅らせて fb 倍した自分の出力を足し続ける → そこから元の音を引いて、こだまだけ残す
echo = _ <: ((+ ~ (de.delay(96000, d) : *(fb))), _) : -;

// 安全装置: どんな音が来ても ±0.5 を超えないように切る
safety = max(-0.5) : min(0.5);

// UR12 の入力1と入力2を足す
bass = +;

process = bass : *(3) : echo : *(mix) : safety <: _, _;
