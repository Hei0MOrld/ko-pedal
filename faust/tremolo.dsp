// トレモロ(音量が波のように揺れる)— 2026-09-30 試作 1 号・強め版
// KO の方針「操作する前からエフェクトがかかってるのがわかるように」に合わせて、
// 深さ最大・エフェクトの音を 4 倍にして、UR12 が返す元の音に埋もれないようにした。
import("stdfaust.lib");

rate  = hslider("[0]速さ(Hz)", 4, 0.5, 12, 0.1) : si.smoo;
depth = hslider("[1]深さ", 1, 0, 1, 0.01) : si.smoo;
level = hslider("[2]音量", 1, 0, 1, 0.01) : si.smoo;

// 深さ 0 = 揺れない、1 = 音が消えるところまで揺れる
trem = 1 - depth * (0.5 + 0.5 * os.osc(rate));

// 安全装置: どんな音が来ても ±0.5 を超えないように切る
safety = max(-0.5) : min(0.5);

// UR12 の入力1と入力2を足す
bass = +;

process = bass : *(4) : *(trem) : *(level) : safety <: _, _;
